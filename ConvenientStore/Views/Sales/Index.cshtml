@model IEnumerable<ConvenientStore.Models.Sale>

@{
    ViewData["Title"] = "Sales";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Sales History</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> New Sale
        </a>
        <a asp-action="DailySummary" class="btn btn-info">
            <i class="fas fa-chart-bar"></i> Daily Summary
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Sale Date</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Payment Method</th>
                        <th>Total Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(string.IsNullOrEmpty(item.CustomerName) ? "Walk-in Customer" : item.CustomerName)</td>
                            <td>@item.SaleItems.Count items</td>
                            <td>
                                <span class="badge bg-info">@item.PaymentMethod</span>
                            </td>
                            <td><strong>$@item.TotalAmount.ToString("F2")</strong></td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                                    <a asp-action="Receipt" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Receipt</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <p class="text-muted">No sales found.</p>
                <a asp-action="Create" class="btn btn-primary">Create your first sale</a>
            </div>
        }
    </div>
</div>