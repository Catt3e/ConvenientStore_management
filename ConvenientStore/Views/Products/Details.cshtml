@model ConvenientStore.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@Html.DisplayFor(model => model.Name)</h5>
                <p class="card-text">@Html.DisplayFor(model => model.Description)</p>
                
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Category:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Category.Name)</dd>
                            
                            <dt class="col-sm-4">Price:</dt>
                            <dd class="col-sm-8">$@Html.DisplayFor(model => model.Price)</dd>
                            
                            <dt class="col-sm-4">Stock:</dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.StockQuantity)
                                @if (Model.StockQuantity <= 10)
                                {
                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                }
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Barcode:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Barcode)</dd>
                            
                            <dt class="col-sm-4">Created:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.CreatedDate)</dd>
                            
                            <dt class="col-sm-4">Status:</dt>
                            <dd class="col-sm-8">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>