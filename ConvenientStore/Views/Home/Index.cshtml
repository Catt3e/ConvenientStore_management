@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-12">
        <h1 class="display-4">🏪 Store Dashboard</h1>
        <hr />
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4>@ViewBag.TotalProducts</h4>
                        <p class="card-text">Total Products</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-box fa-2x"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-controller="Products" asp-action="Index" class="text-white">View Products</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4>@ViewBag.LowStockProducts</h4>
                        <p class="card-text">Low Stock Items</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-exclamation-triangle fa-2x"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-controller="Products" asp-action="Index" class="text-white">Check Inventory</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4>$@ViewBag.TodaySales.ToString("F2")</h4>
                        <p class="card-text">Today's Sales</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-dollar-sign fa-2x"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-controller="Sales" asp-action="DailySummary" class="text-white">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4>@ViewBag.TotalCategories</h4>
                        <p class="card-text">Categories</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-tags fa-2x"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-controller="Categories" asp-action="Index" class="text-white">View Categories</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6">
                        <a asp-controller="Sales" asp-action="Create" class="btn btn-primary btn-block mb-2">
                            <i class="fas fa-cash-register"></i> New Sale
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-controller="Products" asp-action="Create" class="btn btn-success btn-block mb-2">
                            <i class="fas fa-plus"></i> Add Product
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-controller="Categories" asp-action="Create" class="btn btn-info btn-block mb-2">
                            <i class="fas fa-tag"></i> Add Category
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-controller="Sales" asp-action="Index" class="btn btn-secondary btn-block mb-2">
                            <i class="fas fa-list"></i> View Sales
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Recent Sales</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.RecentSales != null && ((IEnumerable<ConvenientStore.Models.Sale>)ViewBag.RecentSales).Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Customer</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in (IEnumerable<ConvenientStore.Models.Sale>)ViewBag.RecentSales)
                                {
                                    <tr>
                                        <td>@sale.SaleDate.ToString("MM/dd HH:mm")</td>
                                        <td>@(string.IsNullOrEmpty(sale.CustomerName) ? "Walk-in" : sale.CustomerName)</td>
                                        <td>$@sale.TotalAmount.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No recent sales</p>
                }
                <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-outline-primary">View All Sales</a>
            </div>
        </div>
    </div>
</div>
